	function Window:SetSize(Width, Height)
		Width = math.clamp(Width, Window.MinSize.X, Window.MaxSize.X)
		Height = math.clamp(Height, Window.MinSize.Y, Window.MaxSize.Y)

		Root.Size = UDim2.fromOffset(Width, Height)
	end

	function Window:GetSize()
		return Root.AbsoluteSize
	end

	function Window:SetMinSize(Width, Height)
		Window.MinSize = Vector2.new(Width, Height)
	end

	function Window:SetMaxSize(Width, Height)
		Window.MaxSize = Vector2.new(Width, Height)
	end

	function Window:Open()
		Root.Visible = true
		Reopen.Visible = false
	end

	function Window:Hide()
		Root.Visible = false
		Reopen.Visible = true
	end

	function Window:Destroy()
		Root:Destroy()
		Reopen:Destroy()
	end

	Window.Root = Root
	Window.Reopen = Reopen
	Window.ResizeHandle = ResizeHandle
	Window.NotificationHolder = NotificationHolder

	table.insert(self.Windows, Window)

	task.defer(UpdateTextScale)

	return Window
end

function Library:Destroy()
	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end
end

return Library
