	function Window:Notify(Text, Type, Duration)
		local Color = Theme.AccentBright

		if Type == "Success" then
			Color = Theme.Success
		elseif Type == "Warning" then
			Color = Theme.Warning
		elseif Type == "Error" then
			Color = Theme.Error
		end

		local Notification = Create("Frame", {
			Parent = NotificationHolder,
			Size = UDim2.fromOffset(300, 58),
			BackgroundColor3 = Theme.Surface2,
			BorderSizePixel = 0
		})

		AddCorner(Notification, 10)
		AddStroke(Notification, Theme.Border, 1, 0)

		local Bar = Create("Frame", {
			Parent = Notification,
			Size = UDim2.fromOffset(4, 58),
			BackgroundColor3 = Color,
			BorderSizePixel = 0
		})

		AddCorner(Bar, 99)

		local Label = Create("TextLabel", {
			Parent = Notification,
			Position = UDim2.fromOffset(15, 5),
			Size = UDim2.new(1, -24, 1, -10),
			BackgroundTransparency = 1,
			Text = tostring(Text),
			TextWrapped = true,
			TextColor3 = Theme.Text,
			TextSize = 12,
			Font = Enum.Font.Gotham,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center
		})

		task.delay(Duration or 2.5, function()
			if Notification.Parent then
				Tween(Notification, 0.2, {
					BackgroundTransparency = 1
				})

				Tween(Label, 0.2, {
					TextTransparency = 1
				})

				task.wait(0.22)
				Notification:Destroy()
			end
		end)
	end

	function Window:SelectTab(Name)
		local Tab = self.Tabs[Name]

		if not Tab then
			return
		end

		for _, OtherTab in pairs(self.Tabs) do
			OtherTab.Content.Visible = false
			OtherTab.Button.TextColor3 = Theme.SubText
			OtherTab.Indicator.Visible = false

			Tween(OtherTab.Button, 0.12, {
				BackgroundColor3 = Theme.Surface
			})
		end

		Tab.Content.Visible = true
		Tab.Button.TextColor3 = Theme.Text
		Tab.Indicator.Visible = true

		Tween(Tab.Button, 0.12, {
			BackgroundColor3 = Theme.Surface3
		})

		self.SelectedTab = Name
	end

