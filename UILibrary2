			function Section:AddSlider(Config)
				Config = Config or {}

				local Minimum = Config.Min or 0
				local Maximum = Config.Max or 100
				local Value = math.clamp(Config.Default or Minimum, Minimum, Maximum)
				local Row = NewRow(50)

				AddCorner(Row, 7)

				Create("TextLabel", {
					Parent = Row,
					Position = UDim2.fromOffset(10, 2),
					Size = UDim2.new(1, -90, 0, 20),
					BackgroundTransparency = 1,
					Text = tostring(Config.Text or "Slider"),
					TextColor3 = Theme.Text,
					TextSize = 10,
					Font = Enum.Font.GothamMedium,
					TextXAlignment = Enum.TextXAlignment.Left
				})

				local ValueLabel = Create("TextLabel", {
					Parent = Row,
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -10, 0, 2),
					Size = UDim2.fromOffset(70, 20),
					BackgroundTransparency = 1,
					Text = tostring(Value),
					TextColor3 = Theme.AccentBright,
					TextSize = 10,
					Font = Enum.Font.Code,
					TextXAlignment = Enum.TextXAlignment.Right
				})

				local Track = Create("Frame", {
					Parent = Row,
					Position = UDim2.new(0, 10, 1, -16),
					Size = UDim2.new(1, -20, 0, 5),
					BackgroundColor3 = Theme.Surface3,
					BorderSizePixel = 0
				})

				AddCorner(Track, 99)

				local Fill = Create("Frame", {
					Parent = Track,
					Size = UDim2.new((Value - Minimum) / math.max(Maximum - Minimum, 0.001), 0, 1, 0),
					BackgroundColor3 = Theme.AccentBright,
					BorderSizePixel = 0
				})

				AddCorner(Fill, 99)

				local Dragging = false

				local function Update(InputX, Fire)
					local Percent = math.clamp(
						(InputX - Track.AbsolutePosition.X) / math.max(Track.AbsoluteSize.X, 1),
						0,
						1
					)

					local Raw = Minimum + ((Maximum - Minimum) * Percent)

					if Config.Round == false then
						Value = Raw
					else
						Value = math.floor(Raw + 0.5)
					end

					Fill.Size = UDim2.new(Percent, 0, 1, 0)
					ValueLabel.Text = tostring(Value)

					if Fire and type(Config.Callback) == "function" then
						Config.Callback(Value)
					end
				end

				Track.InputBegan:Connect(function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1
						or Input.UserInputType == Enum.UserInputType.Touch
					then
						Dragging = true
						Update(Input.Position.X, true)
					end
				end)

				UserInputService.InputChanged:Connect(function(Input)
					if Dragging and (
						Input.UserInputType == Enum.UserInputType.MouseMovement
						or Input.UserInputType == Enum.UserInputType.Touch
					) then
						Update(Input.Position.X, true)
					end
				end)

				UserInputService.InputEnded:Connect(function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseButton1
						or Input.UserInputType == Enum.UserInputType.Touch
					then
						Dragging = false
					end
				end)

				local Api = {}

				function Api:Set(NewValue)
					Value = math.clamp(NewValue, Minimum, Maximum)

					local Percent = (Value - Minimum) / math.max(Maximum - Minimum, 0.001)

					Fill.Size = UDim2.new(Percent, 0, 1, 0)
					ValueLabel.Text = tostring(Value)

					if type(Config.Callback) == "function" then
						Config.Callback(Value)
					end
				end

				function Api:Get()
					return Value
				end

				return Api
			end

